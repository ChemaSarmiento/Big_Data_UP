+/* ---------- Marca: chema-kit ---------- */
+/* Títulos en Source Serif 4 600; texto en IBM Plex Sans; cifras y código en IBM Plex Mono.
+   Estructura con líneas de 1 px, sin sombras ni degradados. Un solo rojo por pantalla. */
+.brand{display:flex;align-items:center;gap:12px;font:600 22px/1 var(--font-display);letter-spacing:0}
+.brand svg{width:32px;height:32px;flex:none}
+.brand span{font:600 12px/1 var(--font-sans);letter-spacing:.08em;color:var(--muted)}
+.header-note{font:600 12px/16px var(--font-sans);letter-spacing:.08em}
+#theme{padding:8px 12px;font-size:13px}
+.eyebrow{font:600 12px/16px var(--font-sans);letter-spacing:.08em;text-transform:uppercase}
+.intro h1{font-family:var(--font-display);font-weight:600;letter-spacing:-.02em}
+.intro em{font:italic 600 1em var(--font-display);color:var(--accent)}
+.deck{background:var(--surface-200);border-radius:8px}
+.deck h2,#slide h1,dialog h2,.dialog-header h2{font-family:var(--font-display);font-weight:600}
+.deck h2{letter-spacing:-.01em}
+.deck-number{font:600 24px var(--font-mono);font-style:normal}
+#counter{font:500 16px var(--font-mono)}
+#slide h1{letter-spacing:-.01em}
+#slide h2{font-family:var(--font-sans);font-weight:600}
+.cover h1{font:italic 600 32px var(--font-display)!important}
+.cover h2{font-family:var(--font-display)!important;font-weight:600!important;letter-spacing:-.02em}
+#slide pre,#slide code{font-family:var(--font-mono)}
+#slide table td{font-variant-numeric:tabular-nums}
+#slide blockquote,.box{border-radius:0 8px 8px 0}
+/* La señal: en un callout, la cifra o frase clave en negritas va en rojo. */
+#slide blockquote strong,.box strong{color:var(--signal-ink)}
+button,dialog,.deck{border-radius:8px}
+
+/* Infográficos SVG en línea: sus colores fijos se remapean a los tokens, así siguen el tema. */
+.infographic text,.infographic g{font-family:var(--font-sans)}
+.infographic [fill="#172139"]{fill:var(--ink)}
+.infographic [fill="#647086"]{fill:var(--ink-muted)}
+.infographic [stroke="#647086"]{stroke:var(--ink-muted)}
+.infographic [fill="#2345cc"]{fill:var(--brand)}
+.infographic [stroke="#2345cc"]{stroke:var(--brand)}
+.infographic [fill="#ffffff"]{fill:var(--surface-100)}
+.infographic [stroke="#d9dde7"]{stroke:var(--line)}
+.infographic [fill="#edf0fc"]{fill:var(--surface-200)}
+.infographic [fill="#aeb8cd"]{fill:var(--line)}
+/* Imágenes raster (PNG) del curso: en tema oscuro se enmarcan para no flotar como un bloque blanco. */
+:root[data-theme="dark"] #slide img{background:#f6f4ef;border-radius:8px;padding:8px}
+@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) #slide img{background:#f6f4ef;border-radius:8px;padding:8px}}
+#catalog{margin-left:0}
+@media(max-width:800px){#theme{margin-left:auto}.brand span{display:none}}
